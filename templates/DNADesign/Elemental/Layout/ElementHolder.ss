<%-- $BlockWidthClass and $SpacingClasses come from silverwind-blocks: each top-level block sets its own width and space around it --%>
<div class="sw-element element $SimpleClassName.LowerCase<% if $BlockWidthClass %> $BlockWidthClass<% end_if %><% if $SpacingClasses %> $SpacingClasses<% end_if %><% if $StyleVariant %> $StyleVariant<% end_if %><% if $ExtraClass %> $ExtraClass<% end_if %>" id="$Anchor">
    $Element
</div>
